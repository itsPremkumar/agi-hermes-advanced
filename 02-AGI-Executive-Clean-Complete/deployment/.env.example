# .env — secrets for AGI Executive Agent
# Copy this file to .env and fill in real values. Never commit .env to git.
# This file is NOT loaded from deployment/ — place it at ~/.hermes/.env or project root per your harness.

# Model provider API keys (set only the one you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
NOUS_API_KEY=

# Optional: custom model endpoint
# BASE_URL=

# Optional: tool-specific secrets
# GITHUB_TOKEN=
# SEARCH_API_KEY=
